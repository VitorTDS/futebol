{
  "name": "projeto-futebol",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard do Brasileirão com previsões (Poisson) e simulação Monte Carlo",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "chaves-push": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.2"
  }
}
