# Copie este arquivo para ".env" e preencha.

# Token grátis em https://www.football-data.org/client/register
# Sem token, o sistema roda com dados de exemplo.
FOOTBALL_DATA_TOKEN=

# Código da competição na football-data.org (BSA = Brasileirão Série A)
COMPETITION=BSA

# Temporada (ano). Em branco = temporada atual.
SEASON=

# Link aberto pelo botão "Assistir" de cada jogo
WATCH_URL=https://globoplay.globo.com/

# Modelo de previsão: dixon-coles (padrão) ou poisson
MODEL=dixon-coles

# Dixon-Coles: quanto o peso dos jogos antigos cai por dia (0 = todos pesam igual).
# auto = calibra pelo histórico de acertos (padrão). Um número fixa o valor, ex.: 0.003
TIME_DECAY=auto

# Quantas temporadas anteriores o Dixon-Coles usa (0 = só a atual).
# Ajuda muito no começo do campeonato. Se a sua chave não tiver acesso, o sistema avisa e segue sem.
PREVIOUS_SEASONS=1

# Quantidade de temporadas simuladas no Monte Carlo
SIMULATIONS=10000

# Scout de jogadores: chave grátis em https://dashboard.api-football.com/register
# Sem chave, o scout usa jogadores de exemplo.
APIFOOTBALL_KEY=
# 71 = Brasileirão Série A na API-Football
APIFOOTBALL_LEAGUE=71
# Temporada (ano). Em branco = ano atual. Confira no painel da API-Football quais temporadas seu plano libera.
APIFOOTBALL_SEASON=
# Minutos mínimos para um jogador entrar na comparação
SCOUT_MIN_MINUTES=450

PORT=3000
